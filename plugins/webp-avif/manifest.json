{
  "id": "webp-avif",
  "name": "WEBP to AVIF",
  "version": "1.0.0",
  "description": "Convert WebP images to AVIF format",
  "author": "PhaiXD",
  "icon": "🎨",
  "min_core_version": "2.0.0",
  "tools": [
    {
      "id": "webp-avif",
      "name": "WEBP to AVIF",
      "description": "Convert WebP images to AVIF format",
      "icon": "🎨",
      "category": "image",
      "mode": "convert",
      "inputs": {
        "type": "file",
        "accept": [
          ".webp"
        ]
      },
      "command": "plugin.bat",
      "args": [
        "webp-avif",
        "{input_file}",
        "{output_file}"
      ],
      "output_ext": ".avif"
    }
  ]
}
