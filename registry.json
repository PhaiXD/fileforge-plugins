        {
          "id": "png-jpg",
          "name": "PNG to JPG",
          "description": "Convert PNG images to JPG format",
          "icon": "\ud83d\uddbc\ufe0f",
          "category": "image",
          "mode": "convert",
          "inputs": {
            "type": "file",
            "accept": [
