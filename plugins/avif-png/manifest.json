{
  "id": "avif-png",
  "name": "AVIF to PNG",
  "version": "1.0.0",
  "description": "Convert AVIF images to PNG format",
  "author": "PhaiXD",
  "icon": "🎨",
  "min_core_version": "2.0.0",
  "tools": [
    {
      "id": "avif-png",
      "name": "AVIF to PNG",
      "description": "Convert AVIF images to PNG format",
      "icon": "🎨",
      "category": "image",
      "mode": "convert",
      "inputs": {
        "type": "file",
        "accept": [
          ".avif"
        ]
      },
      "command": "plugin.bat",
      "args": [
        "avif-png",
        "{input_file}",
        "{output_file}"
      ],
      "output_ext": ".png"
    }
  ]
}
